{
  "name": "flume",
  "version": "0.1.0",
  "description": "Stateless bridge from external webhooks to AgentInbox events",
  "type": "module",
  "bin": {
    "flume": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "scripts"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@holon-run/agentinbox": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
