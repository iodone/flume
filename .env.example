# Copy to .env, set permissions to 600, and fill in your deployment values.
# Values here override same-name shell variables and run-flume.sh defaults.

FLUME_ADAPTERS=github
AGENTINBOX_SOURCE_ID=src_your_source
FLUME_BIND=0.0.0.0
FLUME_PORT=19420
# Choose URL or exec. Any executable receives the prompt as its last argument.
# Arguments are split on whitespace, not interpreted by a shell.
# Quote values containing spaces.
FLUME_WAKE_EXEC="hc space your-space-id"
# FLUME_WAKE_EXEC="/absolute/path/to/notify --target ops"
# FLUME_WAKE_URL=http://127.0.0.1:5000/wake
FLUME_AGENTINBOX_AGENT_ID=your-inbox-agent

# Secrets can stay in Keychain. If you put them here, keep the file at mode 600.
# FLUME_GITHUB_SECRET=
# FLUME_GITLAB_TOKEN=
