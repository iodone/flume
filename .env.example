# Copy to .env.local, set permissions to 600, and fill in your deployment values.
# Explicit environment variables override this file; this file overrides run-flume.sh defaults.

FLUME_ADAPTERS=github
AGENTINBOX_SOURCE_ID=src_your_source
FLUME_BIND=0.0.0.0
FLUME_PORT=19420
FLUME_HERDR_WAKE_AGENT=your-coordinator-agent
FLUME_AGENTINBOX_AGENT_ID=your-inbox-agent
FLUME_AGENTINBOX_INTAKE_SKILL=/absolute/path/to/SKILL.md
HERDR_BIN_PATH=/absolute/path/to/herdr
FLUME_HERDR_WAKE_TIMEOUT=10

# Secrets can stay in Keychain. If you put them here, keep the file at mode 600.
# FLUME_GITHUB_SECRET=
# FLUME_GITLAB_TOKEN=

# Optional HTTP wake target instead of a command-based waker.
# FLUME_HERDR_WAKE_URL=http://127.0.0.1:5000/wake
